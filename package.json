{
  "name": "nexus-operations-cockpit",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS Operations Cockpit foundation",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/packages/**/test/*.test.js\"",
    "desktop": "npm run start --workspace @nexus/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "electron@45.3.2": true,
    "esbuild@0.28.2": true
  }
}
